# Screenshot Framer config (key=value)
enabled=1
watch_dir=/sdcard/Pictures/Screenshots
frames_dir=/data/adb/screenshot_frame/frames
# native = keep screenshot pixels 1:1 (frame is scaled up); frame = output has the frame PNG's size
res=native
# cover = fill screen and crop edges, stretch = fill without keeping ratio
mode=cover
# landscape screenshots: which way the frame is rotated (ccw = camera ends up on the left)
rot=ccw
# profile name (profiles/<name>.conf) used when no profile matches the screenshot size
active=
# screen recording framing: 0 = off, 1 = on (switch on the overview page)
rec_enabled=0
# recordings folder; empty = detect automatically
rec_dir=
# per-channel frame (profiles/<name>.conf) and output settings; empty = automatic / general value
shot_frame=
shot_res=
shot_mode=
shot_rot=
rec_frame=
rec_res=
rec_mode=
rec_rot=
# screen resolution (WxH) a full-screen screenshot must have, one setting for all frames; empty = the device's own
screen_res=
